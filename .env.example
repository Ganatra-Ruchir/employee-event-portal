# Example only. NEVER commit real database URLs, passwords, tokens or employee data.
# For Railway staging / Vercel preview:
PORTAL_BACKEND_MODE=database
PORTAL_V3_ENABLED=true
PORTAL_V4_ENABLED=true
NEXT_PUBLIC_PORTAL_DATABASE_ENABLED=true
NEXT_PUBLIC_PORTAL_V4_ENABLED=true

# If the web app runs on Railway alongside PostgreSQL, use the Railway private DATABASE_URL.
# If the app runs on Vercel, use Railway's DATABASE_PUBLIC_URL in the Vercel DATABASE_URL secret.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# For a public endpoint use verified TLS and provide DATABASE_CA_CERT if required.
# Railway private host (*.railway.internal) automatically uses the private connection mode.
DATABASE_SSL_MODE=verify-full

# Only enable while manually running migrations on an isolated STAGING database.
ALLOW_STAGING_MIGRATIONS=false

# Legacy email verification may need provider configuration described in docs/NEON_STAGING_SETUP.md.
